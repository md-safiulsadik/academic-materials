### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-file
*.flf
#Test results file
TestResults.xml

# -------------------------------------------------
# OS-specific files
# -------------------------------------------------
.DS_Store          # macOS
Thumbs.db          # Windows
desktop.ini        # Windows

# -------------------------------------------------
# Compiled source code
# -------------------------------------------------
*.o
*.obj
*.so
*.dll
*.exe
*.out
*.class
*.pyc
*.pyo
*.jar
*.war
*.swp

# -------------------------------------------------
# Executables and binaries
# -------------------------------------------------
a.out
*.elf
*.bin

# -------------------------------------------------
# Archives and compressed files
# -------------------------------------------------
*.zip
*.tar.gz
*.rar
*.7z

# -------------------------------------------------
# Logs
# -------------------------------------------------
*.log

# -------------------------------------------------
# Temporary and backup files
# -------------------------------------------------
*.tmp
*.bak
*.swp
*~
*.old

# -------------------------------------------------
# Editor/IDE settings
# -------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace

# -------------------------------------------------
# Dependency directories
# -------------------------------------------------
node_modules/
venv/
.env
.env.local

# -------------------------------------------------
# Git itself
# -------------------------------------------------
.gitignore

# -------------------------------------------------
# Optional: Ignore everything except source files
# -------------------------------------------------
# Uncomment if you want to only track source code
# * 
# !*.c
# !*.h
# !*.cpp
# !*.py
# !*.java
